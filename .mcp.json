{
  "$schema": "https://raw.githubusercontent.com/anthropics/claude-code/main/.mcp.schema.json",
  "mcpServers": {
    "context7": {
      "$comment": "Up-to-date documentation and code examples via Context7",
      "command": "cmd.exe",
      "args": ["/c", "npx -y @upstash/context7-mcp@latest"]
    },
    "sequential-thinking": {
      "$comment": "Step-by-step reasoning for complex problems",
      "command": "cmd.exe",
      "args": ["/c", "npx -y @modelcontextprotocol/server-sequential-thinking"]
    },
    "moai-lsp": {
      "$comment": "LSP code intelligence via moai binary (goto definition, find references, hover, diagnostics, rename)",
      "command": "moai",
      "args": ["mcp", "lsp"],
      "timeout": 30
    },
     "playwright": {
      "type": "stdio",
      "command": "C:\\Program Files\\nodejs\\node.exe",
      "args": [
        "C:\\Users\\taewo\\AppData\\Roaming\\npm\\node_modules\\@playwright\\mcp\\cli.js"
      ],
      "env": {}
    },
    "hwp-mcp": {
      "type": "stdio",
      "command": "C:\\Program Files\\nodejs\\node.exe",
      "args": [
        "C:\\Users\\taewo\\AppData\\Roaming\\npm\\node_modules\\hwp-mcp\\dist\\server.js"
      ],
      "env": {}
    }
  },
  "staggeredStartup": {
    "enabled": true,
    "delayMs": 500,
    "connectionTimeout": 15000
  }
}
