{
  "$schema": "https://raw.githubusercontent.com/anthropics/claude-code/main/.mcp.schema.json",
  "mcpServers": {
    "context7": {
      "$comment": "Up-to-date documentation and code examples via Context7",
      "command": "/home/taewook/.nvm/versions/node/v22.22.3/bin/npx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    },
    "sequential-thinking": {
      "$comment": "Step-by-step reasoning for complex problems",
      "command": "/home/taewook/.nvm/versions/node/v22.22.3/bin/npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "moai-lsp": {
      "$comment": "LSP code intelligence via moai binary (goto definition, find references, hover, diagnostics, rename)",
      "command": "moai",
      "args": ["mcp", "lsp"],
      "timeout": 30
    },
    "playwright": {
      "type": "stdio",
      "command": "/home/taewook/.nvm/versions/node/v22.22.3/bin/node",
      "args": [
        "/home/taewook/.nvm/versions/node/v22.22.3/lib/node_modules/@playwright/mcp/cli.js",
        "--browser", "chromium",
        "--executable-path", "/home/taewook/.cache/ms-playwright/chromium-1217/chrome-linux64/chrome"
      ],
      "env": {}
    },
    "hwp-mcp": {
      "type": "stdio",
      "command": "/home/taewook/.nvm/versions/node/v22.22.3/bin/node",
      "args": [
        "/home/taewook/.nvm/versions/node/v22.22.3/lib/node_modules/hwp-mcp/dist/server.js"
      ],
      "env": {}
    }
  },
  "staggeredStartup": {
    "enabled": true,
    "delayMs": 500,
    "connectionTimeout": 15000
  }
}
