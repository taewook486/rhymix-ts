# ============================================
# Rhymix-TS Environment Variables — Example
# ============================================
# Copy to .env.local and fill in actual values.
# .env.local is gitignored.

# --- Database (PostgreSQL 16+) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://rhymix:rhymix@127.0.0.1:5444/rhymix_ts?schema=public"

# Shadow database for Prisma migrate (optional, used in development)
SHADOW_DATABASE_URL=""

# --- Auth.js v5 ---
# Generate via: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# --- Application ---
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Install Lock (set to "1" after install completes) ---
INSTALL_LOCK=""

# --- Optional: Email transport (SPEC-MAIL-001) ---
# SMTP_HOST is required to enable real email delivery.
# When unset, NoopMailDispatcher is used (mails are logged to console only).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Rhymix-TS <noreply@example.com>"
# SMTP_SECURE: set to "true" for port 465 (SSL), "false" for STARTTLS (default)
SMTP_SECURE="false"

# --- Optional: File storage (S3-compatible) ---
# S3_ENDPOINT=""
# S3_REGION=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
