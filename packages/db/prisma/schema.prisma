// Rhymix-TS Prisma Schema
//
// SPEC sources:
//   - SPEC-INSTALL-001 (Site, SiteSetting, ModuleInstance, Domain)
//   - SPEC-AUTH-001    (User + auth domain models — Slice A expansion)
//   - SPEC-CONTENT-001 (Document, Comment, FileAttachment — DEFERRED)
//   - SPEC-ADMIN-001   (Domain, ModuleInstance, Menu, Widget — partial)
//   - SPEC-THEME-001   (Theme, Layout, Skin, ThemeAssignment — DEFERRED)
//   - SPEC-POINT-001  (Point system — Slice A: packages/point/ + schema)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // SPEC-AUTH-001 REQ-AUTH-002: citext for case-insensitive identifier columns.
  // pgcrypto is reserved for future random/HMAC helpers (audit log, tokens).
  extensions = [citext, pgcrypto]
}

// =====================================================================
// SPEC-INSTALL-001: Site bootstrap (created during procInstall)
// =====================================================================

model Site {
  id                    Int       @id @default(autoincrement())
  defaultLanguage       String    @default("en")
  timeZone              String    @default("UTC")
  scheme                String    @default("https") // 'http' | 'https'
  installedAt           DateTime?
  installedBy           Int?
  installerIp           String?
  installerUserAgent    String?
  rhymixTsVersion       String    @default("0.0.0")
  databaseSchemaVersion String    @default("init")

  settings        SiteSetting[]
  domains         Domain[]
  menus           Menu[]
  moduleInstances ModuleInstance[]
  dailyVisits     DailyVisit[]
  spamDeniedWords  SpamDeniedWord[]
  spamDeniedIps    SpamDeniedIp[]
  spamRules        SpamRule[]
  spamUrlBlacklists SpamUrlBlacklist[]
  polls            Poll[]
  terms           Terms[]

  @@map("sites")
}

model SiteSetting {
  id        Int      @id @default(autoincrement())
  siteId    Int
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, key])
  @@index([key])
  @@map("site_settings")
}

// =====================================================================
// SPEC-ADMIN-001: Multi-domain + module instance system (Slice A)
// =====================================================================

model Domain {
  id                    Int             @id @default(autoincrement())
  siteId                Int
  // citext 로 대소문자 무관 유니크 제약 (REQ-ADMIN-001 정신 — hostname 도 동일)
  hostname              String          @unique @db.Citext
  isDefault             Boolean         @default(false)
  // REQ-ADMIN-014: HTTPS 강제 플래그 — Slice B 미들웨어가 이 컬럼을 본다
  forceHttps            Boolean         @default(true)
  defaultLanguage       String?
  defaultTimezone       String?
  // SPEC-LAYOUT-001 REQ-LAYOUT-003: layout ID를 String? (cuid)로 변경
  defaultLayoutId       String?
  defaultMobileLayoutId String?
  defaultMenuId         Int?
  // REQ-ADMIN-006: 이 도메인의 인덱스(홈) 모듈 인스턴스
  indexModuleInstanceId Int?
  // install 호환성을 위해 scheme 컬럼 유지 (Slice B 미들웨어는 forceHttps 만 사용)
  scheme                String          @default("https")
  // 도메인별 설정 (robots, csp 등) — Slice B 에서 채워짐
  settings              Json            @default("{}")
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  site                Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  indexModuleInstance ModuleInstance?      @relation("IndexModule", fields: [indexModuleInstanceId], references: [id])
  slotAssignments     MenuSlotAssignment[]

  @@index([siteId])
  @@map("domains")
}

// SPEC-ADMIN-001 Slice A — 완전 정의 (stub 에서 교체)
// REQ-ADMIN-001: mid citext, 길이 1-80, 패턴 ^[a-z0-9][a-z0-9_-]*$
// REQ-ADMIN-007: ModuleConfig 1:1 분리 (configSchema Zod 검증)
model ModuleInstance {
  id             Int           @id @default(autoincrement())
  siteId         Int
  // REQ-ADMIN-001: moduleCode "board", "wiki", "shop" 등 전역 고유 모듈 식별자
  moduleCode     String
  // REQ-ADMIN-001: citext + @@unique([siteId, mid]) — 사이트 범위 내 유니크
  mid            String        @db.Citext
  name           String
  browserTitle   String?
  description    String?
  // SPEC-LAYOUT-001 REQ-LAYOUT-003: layout ID를 String? (cuid)로 변경
  layoutId       String?
  mobileLayoutId String?
  skin           String?
  mobileSkin     String?
  menuId         Int?
  isDefault      Boolean       @default(false)
  rssEnabled     Boolean       @default(false)
  rssTitle       String?
  rssDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  site          Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  // REQ-ADMIN-007: 설정은 ModuleConfig 로 분리
  config        ModuleConfig?
  // REQ-ADMIN-006: 이 인스턴스를 인덱스로 사용하는 도메인 역참조
  domainsAsIndex Domain[]     @relation("IndexModule")
  // SPEC-CONTENT-001 Slice A: board 모듈 역참조 (1:1)
  board         Board?

  // SPEC-PAGE-001 REQ-PAGE-001: 페이지 모듈 본문 컬럼 (additive, nullable)
  mcontent      String?       @db.Text

  // 핵심: 전역 @unique 제거 + 사이트 범위 복합 유니크 (Q2 Pre-Flight 결정)
  @@unique([siteId, mid])
  @@index([moduleCode])
  @@map("module_instances")
}

// REQ-ADMIN-007: 인스턴스 코어 필드와 가변 설정(JSON) 분리
model ModuleConfig {
  id               Int            @id @default(autoincrement())
  moduleInstanceId Int            @unique
  // ModuleDefinition.configSchema (Zod) 로 검증된 설정 블롭
  config           Json           @default("{}")
  updatedAt        DateTime       @updatedAt

  moduleInstance ModuleInstance @relation(fields: [moduleInstanceId], references: [id], onDelete: Cascade)

  @@map("module_configs")
}

// REQ-MENU-020: 메뉴 슬롯 enum (SPEC-MENU-001 Slice C)
// @MX:SPEC: SPEC-MENU-001 REQ-MENU-020
enum MenuSlot {
  HEADER_PRIMARY
  FOOTER
  UTILITY
}

// REQ-ADMIN-030: 사이트별 메뉴 + MenuItem 트리
model Menu {
  id          Int        @id @default(autoincrement())
  siteId      Int
  title       String
  isAdminMenu Boolean    @default(false)
  listOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  site               Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  items              MenuItem[]
  slotAssignments    MenuSlotAssignment[]

  @@index([siteId])
  @@map("menus")
}

// REQ-ADMIN-030: parentId 자기 참조 트리 구조
// REQ-ADMIN-032: groupIds ACL
// REQ-ADMIN-033: 버튼 상태별 JSON (normalBtn, hoverBtn, activeBtn)
model MenuItem {
  id              Int        @id @default(autoincrement())
  menuId          Int
  parentId        Int?
  title           String
  url             String?
  icon            String?
  cssClass        String?
  description     String?
  groupIds        Int[]      @default([])
  openInNewWindow Boolean    @default(false)
  expand          Boolean    @default(false)
  listOrder       Int        @default(0)
  normalBtn       Json?
  hoverBtn        Json?
  activeBtn       Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  menu     Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   MenuItem?  @relation("MenuItemTree", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[] @relation("MenuItemTree")

  @@index([menuId, parentId, listOrder])
  @@map("menu_items")
}

// REQ-MENU-021: 도메인별 메뉴 슬롯 배정 (SPEC-MENU-001 Slice C)
// @MX:SPEC: SPEC-MENU-001 REQ-MENU-021
// @MX:WARN: [AUTO] Data migration risk — backfill from defaultMenuId must be idempotent
// @MX:REASON: Migration creates MenuSlotAssignment rows for existing Domains; must be safe to re-run
model MenuSlotAssignment {
  id        Int      @id @default(autoincrement())
  domainId  Int
  slot      MenuSlot
  menuId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  menu   Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)

  // REQ-MENU-023: (domainId, slot) 유니크 제약 — 한 도메인의 한 슬롯은 하나의 메뉴만 가리킴
  // 메뉴 중복 할당 허용 (同一 menuId가 여러 슬롯에 배정될 수 있음)
  @@unique([domainId, slot])
  @@index([domainId])
  @@index([menuId])
  @@map("menu_slot_assignments")
}

// REQ-ADMIN-070~072: 관리자 mutation before/after 감사 로그
// AuditLog (AUTH-001) 와 별도 — PK BigInt, target String, diff Json
model AdminLog {
  id        BigInt   @id @default(autoincrement())
  actorId   Int
  // "create" | "update" | "delete" | "configure" | "cache.purge.all"
  action    String
  // "module:notice" | "menu:1" | "site:settings"
  target    String
  diff      Json     @default("{}")
  ip        String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([actorId, createdAt])
  @@index([target, createdAt])
  @@index([action, createdAt])
  @@map("admin_logs")
}

// REQ-ADMIN-100: 관리자별 즐겨찾기 핀
model AdminFavorite {
  id        Int      @id @default(autoincrement())
  memberId  Int
  label     String
  href      String
  icon      String?
  listOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, listOrder])
  @@map("admin_favorites")
}

// =====================================================================
// SPEC-AUTH-001: Member system (Slice A — full domain model)
//
// Deviation from spec.md sketch: User.id stays as Int @default(autoincrement())
// to preserve compatibility with SPEC-INSTALL-001 seed code and tests. The SPEC
// sketch used cuid() Strings; converting now would require coordinated changes
// across install seed/install-validate and break already-shipped behavior. All
// FK userId columns in this Slice are Int to match.
// =====================================================================

enum UserStatus {
  APPROVED
  UNAUTHED
  DENIED
  SUSPENDED
  DELETED
}

enum EmailAuthTokenType {
  SIGNUP
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum DeniedIdentifierKind {
  USER_ID
  NICK_NAME
}

enum LoginAttemptResult {
  SUCCESS
  INVALID_CREDENTIALS
  STATUS_BLOCKED
  RATE_LIMITED
}

enum PasswordPolicyLevel {
  NORMAL
  STRONG
  VERY_STRONG
}

model User {
  id                Int        @id @default(autoincrement())
  // REQ-AUTH-002: citext for case-insensitive uniqueness on identifier columns.
  userId            String     @unique @db.Citext
  emailAddress      String     @unique @db.Citext
  // SPEC-AUTH-001 PHC-encoded Argon2id hash.
  passwordHash      String
  // Backward-compat tag (install slice). Mirrors PASSWORD_VERSION_TAG in @rhymix-ts/auth.
  passwordVersion   String     @default("argon2id-v1")
  // SPEC-AUTH-001 REQ-AUTH-014: explicit algo + last-changed timestamp drive auto-rehash.
  passwordAlgo      String     @default("argon2id")
  passwordChangedAt DateTime   @default(now()) @db.Timestamptz
  userName          String?
  // citext on nickName so duplicate-only-by-case is rejected (REQ-AUTH-002 spirit).
  nickName          String     @unique @db.Citext
  phoneNumber       String?    @unique
  phoneCountry      String?
  status            UserStatus @default(UNAUTHED)
  isAdmin           Boolean    @default(false)
  denied            Boolean    @default(false)
  lastLoginAt       DateTime?  @db.Timestamptz
  lastLoginIp       String?
  extraVars         Json       @default("{}")
  // SPEC-ADMIN-002 Slice 3E REQ-ADMIN2-008: 대시보드 위젯 표시 여부 (관리자 계정별)
  dashboardWidgetPrefs Json? @default("{}")
  createdAt         DateTime   @default(now()) @db.Timestamptz
  updatedAt         DateTime   @updatedAt @db.Timestamptz
  deletedAt         DateTime?  @db.Timestamptz
  // SPEC-AUTH-001 Slice D1 REQ-AUTH-020 enforcement primitive.
  // Denormalized "latest revocation" timestamp; SessionRevocation table holds the audit history.
  // jwt callback compares token.iat against this single column for fast-path enforcement
  // (avoids JOIN/subquery on every request).
  sessionsRevokedAt DateTime?  @db.Timestamptz

  groups            MemberGroupMember[]
  autoLogins        AutoLogin[]
  emailTokens       EmailAuthToken[]
  devices           MemberDevice[]
  agreements        MemberAgreement[]
  revocations       SessionRevocation[]
  adminFavorites    AdminFavorite[]
  socialAccounts    SocialAccount[]
  // SPEC-CONTENT-001 Slice A: 게시판 모듈 역참조
  documentsAuthored Document[]          @relation("DocumentAuthor")
  commentsAuthored  Comment[]           @relation("CommentAuthor")
  documentUpdates   DocumentUpdateLog[]
  trashDeleted      Trash[]
  // SPEC-POINT-001 REQ-POINT-001: 포인트 시스템
  pointBalance             Int                      @default(0)
  points                   Point[]                  @relation("UserPoints")
  // SPEC-NOTIFICATION-001 REQ-NOTIF-001: 알림 시스템
  notifications            Notification[]           @relation("UserNotifications")
  notificationPreferences  NotificationPreference[] @relation("UserNotificationPreferences")
  // SPEC-MESSAGE-001 REQ-MSG-001: 쪽지 시스템
  messagesSent             Message[]               @relation("MessageSender")
  messagesReceived         Message[]               @relation("MessageReceiver")
  // SPEC-ADMIN-002 Slice 3B REQ-ADMIN2-056/057: 닉네임 변경 이력
  nicknameChangeLogs NicknameChangeLog[] @relation("NicknameChangeLogUser")
  // SPEC-ADMIN-2FA-OTP-001 REQ-2OTP-001: 2FA TOTP secret + status
  twoFactorSecret       String?    @db.Text   // AES-256-GCM 암호문 (base64 인코딩된 IV+tag+ciphertext)
  twoFactorEnabled      Boolean    @default(false)
  twoFactorConfirmedAt  DateTime?  @db.Timestamptz
  twoFactorBackupCodes  Json       @default("[]")  // SHA-256 해시 배열 (1회용 백업 코드)

  @@index([status])
  @@index([emailAddress])
  @@index([createdAt])
  @@map("users")
}

model MemberGroup {
  id        Int      @id @default(autoincrement())
  siteId    Int?
  title     String
  isDefault Boolean  @default(false)
  description String?  @db.Text
  isAdmin   Boolean  @default(false)
  imageMark String?
  listOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz

  members MemberGroupMember[]

  @@map("member_groups")
}

model MemberGroupMember {
  groupId  Int
  userId   Int
  joinedAt DateTime @default(now()) @db.Timestamptz

  group MemberGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@map("member_group_members")
}

// SPEC-AUTH-001 REQ-AUTH-018, REQ-AUTH-019, REQ-AUTH-053: rotating remember-me secret.
model AutoLogin {
  id          Int      @id @default(autoincrement())
  userId      Int
  securityKey String   @unique
  previousKey String?  @unique
  ip          String
  userAgent   String   @db.Text
  deviceId    String?
  createdAt   DateTime @default(now()) @db.Timestamptz
  lastUsedAt  DateTime @default(now()) @db.Timestamptz
  expiresAt   DateTime @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auto_logins")
}

// SPEC-AUTH-001 REQ-AUTH-011, REQ-AUTH-012, REQ-AUTH-016: single-use email tokens.
model EmailAuthToken {
  id         Int                @id @default(autoincrement())
  userId     Int
  authKey    String             @unique
  authType   EmailAuthTokenType
  payload    Json?
  createdAt  DateTime           @default(now()) @db.Timestamptz
  expiresAt  DateTime           @db.Timestamptz
  consumedAt DateTime?          @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, authType])
  @@index([expiresAt])
  @@map("email_auth_tokens")
}

// SPEC-AUTH-001 REQ-AUTH-043: per-device tracking for autologin trust.
model MemberDevice {
  id          Int      @id @default(autoincrement())
  userId      Int
  deviceId    String
  ip          String
  userAgent   String   @db.Text
  firstSeenAt DateTime @default(now()) @db.Timestamptz
  lastSeenAt  DateTime @default(now()) @db.Timestamptz
  trusted     Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("member_devices")
}

// SPEC-AUTH-001 US-AUTH-009: configurable signup form (per-site overrides).
model JoinFormField {
  id        Int      @id @default(autoincrement())
  siteSrl   Int      @default(0)
  fieldName String
  fieldType String
  label     String
  required  Boolean  @default(false)
  visible   Boolean  @default(true)
  fieldOrder Int     @default(0)
  options   Json?

  @@unique([siteSrl, fieldName])
  @@map("join_form_fields")
}

// SPEC-AUTH-001 Open Question 6: legal-agreement versioning at signup time.
model MemberAgreement {
  id           Int      @id @default(autoincrement())
  userId       Int
  agreementKey String
  version      String
  agreedAt     DateTime @default(now()) @db.Timestamptz
  ip           String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, agreementKey])
  @@map("member_agreements")
}

// SPEC-CONTENT-001 Slice E REQ-CONTENT-140: 컨텐츠 쓰기 rate limiting ledger.
// LoginAttempt 패턴 + endpoint 차원 추가.
model ContentRateLimit {
  id         BigInt   @id @default(autoincrement())
  ip         String
  identifier String?  // userId.toString() 또는 익명이면 null
  endpoint   String   // "document.create" | "comment.create" | "attachment.upload"
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([ip, endpoint, createdAt])
  @@index([identifier, endpoint, createdAt])
  @@map("content_rate_limits")
}

// SPEC-AUTH-001 REQ-AUTH-015, REQ-AUTH-033: brute-force / rate-limit ledger.
model LoginAttempt {
  id         Int                @id @default(autoincrement())
  ip         String
  identifier String?
  result     LoginAttemptResult
  createdAt  DateTime           @default(now()) @db.Timestamptz

  @@index([ip, createdAt])
  @@index([createdAt])
  @@map("login_attempts")
}

// SPEC-AUTH-001 REQ-AUTH-052: signup-time blocklist for user_id / nickname patterns.
model DeniedIdentifier {
  id        Int                  @id @default(autoincrement())
  kind      DeniedIdentifierKind
  pattern   String               @db.Citext
  reason    String?
  createdBy String?
  createdAt DateTime             @default(now()) @db.Timestamptz

  @@unique([kind, pattern])
  @@map("denied_identifiers")
}

// SPEC-MEMBER-ADMIN-001 Slice E REQ-MADM-028: 이메일 호스트 관리 (허용/차단 도메인).
//
// 사이트별 선택적 스코프 (siteId Int?)는 MemberGroup.siteId 선례를 따른다.
// citext 확장과 created_by/createdAt 패턴은 DeniedIdentifier를 재사용한다.
enum ManagedEmailHostPolicy {
  ALLOW
  DENY
}

model ManagedEmailHost {
  id        Int                    @id @default(autoincrement())
  siteId    Int?
  host      String                 @db.Citext
  policy    ManagedEmailHostPolicy
  reason    String?
  createdBy String?
  createdAt DateTime               @default(now()) @db.Timestamptz

  @@unique([siteId, host, policy])
  @@map("managed_email_hosts")
}

// SPEC-AUTH-001 REQ-AUTH-004: append-only audit log for state-changing auth events.
model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  targetId  Int?
  action    String
  metadata  Json     @default("{}")
  ip        String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([actorId, createdAt])
  @@index([targetId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// SPEC-AUTH-001 Slice D1 REQ-AUTH-020: session revocation denylist.
//
// JWT 전략을 유지하면서 즉시 무효화 효과를 얻기 위한 테이블. jwt callback 이
// 매 요청마다 User.sessionsRevokedAt (denormalized fast-path) 또는 본 테이블의
// 최신 row 를 조회해 token.iat 와 비교한다. 본 테이블은 audit history 를 보존하며,
// 최신값 비교 자체는 fast-path 컬럼을 사용한다.
//
// reason 컬럼은 문자열 컨벤션 (4종):
//   - STATUS_CHANGED         : admin 이 user.status 를 변경한 경우 (D2)
//   - ADMIN_FORCE_LOGOUT     : admin 이 명시적으로 강제 로그아웃 트리거 (D2)
//   - PASSWORD_CHANGED       : 비밀번호 변경/재설정 후 모든 세션 무효화 (Slice F)
//   - USER_LOGOUT_ALL        : 사용자 본인이 "모든 기기에서 로그아웃" 요청
// 사용 패턴이 안정되면 enum 으로 승격을 검토한다 (D2/E 시점).
model SessionRevocation {
  id        Int      @id @default(autoincrement())
  userId    Int
  revokedAt DateTime @default(now()) @db.Timestamptz
  reason    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("session_revocations")
}

// =====================================================================
// SPEC-SOCIAL-LOGIN-001: Social Account Linkage
// =====================================================================

// REQ-SOCIAL-006: Social account linkage table (custom, NOT Auth.js's Account model).
// This model stores the link between a User and their social OAuth provider accounts.
// One User can have multiple linked social accounts (1:N).
model SocialAccount {
  id                Int      @id @default(autoincrement())
  userId            Int
  provider          String   // 'kakao' | 'google' (future: 'naver', 'facebook')
  providerAccountId String   // Provider-specific unique user ID
  createdAt         DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("social_accounts")
}

// =====================================================================
// SPEC-CAPTCHA-001: Terms of Service / Privacy Policy Management
// =====================================================================

// REQ-CAPTCHA-002: 약관 내용 관리를 위한 Terms 모델
// 사이트별로 이용약관, 개인정보처리방침, 선택 약관을 관리한다
model Terms {
  id        Int      @id @default(autoincrement())
  siteId    Int
  type      String   // 'terms' | 'privacy' | 'custom'
  title     String
  content   String   @db.Text
  required  Boolean  @default(true)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, type, active])
  @@map("terms")
}

// =====================================================================
// SPEC-POINT-001: Point system (Slice A — Foundation)
// =====================================================================

// SPEC-POINT-001 REQ-POINT-001: 포인트 내역
model Point {
  id         Int             @id @default(autoincrement())
  memberId   Int
  amount     Int
  reason     String          @db.VarChar(200)
  sourceType PointSourceType
  sourceId   Int?
  boardId    Int?
  createdAt  DateTime        @default(now()) @db.Timestamptz

  member User @relation("UserPoints", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId])
  @@index([memberId, createdAt(sort: Desc)])
  @@index([memberId])
  @@index([sourceType, sourceId])
  @@index([createdAt])
  @@map("points")
}

// SPEC-POINT-001 REQ-POINT-006: 사이트 포인트 설정 (단일 행)
model SitePointConfig {
  id                   Int     @id @default(1) // 항상 1개 행
  signupBonus          Int     @default(0)
  clampToZero          Boolean @default(true)
  allowNegativeBalance Boolean @default(false)
  defaultLevel         Int     @default(1)

  @@map("site_point_config")
}

// =====================================================================
// SPEC-ADMIN-001 Slice I: WidgetInstance DB 프리셋 (REQ-ADMIN-043)
// =====================================================================

// @MX:NOTE: [AUTO] widgetName 은 packages/core/src/widgets/registry.ts 의 in-memory
//           WidgetRegistry 와 연결 키다. DB 에 WidgetDefinition 을 저장하지 않으며
//           widgetName 문자열로 런타임에 getWidget(widgetName) 으로 조회한다.
// @MX:SPEC: SPEC-ADMIN-001 REQ-ADMIN-043
model WidgetInstance {
  id         Int      @id @default(autoincrement())
  widgetName String
  label      String
  props      Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([widgetName])
  @@map("widget_instances")
}

// =====================================================================
// SPEC-CONTENT-001 Slice A — Foundation 스키마
// =====================================================================

enum DocumentStatus {
  PUBLIC
  SECRET
  TEMP
}

enum CommentStatus {
  ALLOW
  DISABLE
}

enum UploadTargetType {
  DOCUMENT
  COMMENT
}

enum VoteType {
  UP
  DOWN
  BLAME
}

// SPEC-POINT-001 REQ-POINT-001: 포인트 출처 유형
enum PointSourceType {
  DOCUMENT
  COMMENT
  VOTE
  DOWNLOAD
  FILE_UPLOAD
  SIGNUP
  MANUAL
  SYSTEM
  PURCHASE
  REFERRAL
}

// 게시판 설정 테이블 (Board별 별도 정형 컬럼; ModuleConfig JSON 과 공존)
// SPEC-CONTENT-001 REQ-CONTENT-001: 1 ModuleInstance ─ 1 Board (1:1)
model Board {
  id                   Int            @id @default(autoincrement())
  moduleInstanceId     Int            @unique
  moduleSrl            BigInt?        @unique
  name                 String
  description          String?
  skin                 String?
  layoutId             Int?
  mobileSkin           String?
  mobileLayoutId       Int?
  listCount            Int            @default(20)
  pageCount            Int            @default(10)
  orderTarget          String         @default("list_order")
  exceptNotice         Boolean        @default(false)
  consultation         Boolean        @default(false)
  useAnonymous         Boolean        @default(false)
  updateLog            Boolean        @default(false)
  trashUse             Boolean        @default(true)
  useStatus            DocumentStatus[] @default([PUBLIC, SECRET, TEMP])
  useCategory          Boolean        @default(false)
  documentLengthLimit  Int            @default(1048576)
  commentLengthLimit   Int            @default(131072)
  protectDeleteContent Int            @default(0)
  protectUpdateContent Int            @default(0)
  protectDeleteComment Int            @default(0)
  protectUpdateComment Int            @default(0)
  permissions          Json           @default("{}")
  // SPEC-FEED-001 REQ-FEED-050: 게시판별 RSS/Atom 피드 설정 (additive, Zod 검증은 boardFeedConfigSchema)
  feedConfig           Json           @default("{}")
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  moduleInstance ModuleInstance   @relation(fields: [moduleInstanceId], references: [id], onDelete: Cascade)
  documents      Document[]
  categories     DocumentCategory[]
  extraKeys      DocumentExtraKey[]
  // SPEC-POINT-001 REQ-POINT-002: 게시판별 포인트 정책
  pointPerDocument     Int            @default(0)
  pointPerComment      Int            @default(0)
  pointPerVoteUp       Int            @default(0)
  pointPerVoteDown     Int            @default(0)
  pointPerDownload     Int            @default(0)
  pointPerFileUpload   Int            @default(0)

  @@index([moduleSrl])
  @@map("boards")
}

// 게시판 게시물
model Document {
  id              Int            @id @default(autoincrement())
  documentSrl     BigInt?        @unique
  boardId         Int
  categoryId      Int?
  title           String
  titleBold       Boolean        @default(false)
  titleColor      String?
  content         String
  contentText     String?
  authorId        Int?
  userIdSnapshot  String?        @db.Citext
  nickName        String?
  memberId        String?
  email           String?        @db.Citext
  ipAddress       String?
  password        String?
  readedCount     Int            @default(0)
  votedCount      Int            @default(0)
  blamedCount     Int            @default(0)
  commentCount    Int            @default(0)
  trackbackCount  Int            @default(0)
  uploadedCount   Int            @default(0)
  status          DocumentStatus @default(PUBLIC)
  commentStatus   CommentStatus  @default(ALLOW)
  isNotice        Boolean        @default(false)
  langCode        String         @default("ko")
  allowTrackback  Boolean        @default(false)
  notifyMessage   Boolean        @default(false)
  // SPEC-ADMIN-002 Slice 3B REQ-ADMIN2-073: 문서 별칭(URL alias). 1문서당 1개, 전역 유니크.
  alias           String?        @unique @db.VarChar(200)
  extraVars       Json           @default("{}")
  listOrder       BigInt         @default(0)
  updateOrder     BigInt         @default(0)
  regdate         DateTime       @default(now()) @db.Timestamptz
  lastUpdate      DateTime       @updatedAt @db.Timestamptz
  deletedAt       DateTime?      @db.Timestamptz
  searchVector    Unsupported("tsvector")?

  board      Board                @relation(fields: [boardId], references: [id], onDelete: Cascade)
  category   DocumentCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author     User?                @relation("DocumentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  comments   Comment[]
  files      FileAttachment[]     @relation("DocumentFiles")
  updateLogs DocumentUpdateLog[]
  votes          DocumentVote[]
  reports        DocumentReport[]
  trash          Trash?
  documentTags   DocumentTag[]
  documentPolls  DocumentPoll[]

  @@index([boardId, status, regdate(sort: Desc)])
  @@index([boardId, isNotice, listOrder(sort: Desc)])
  @@index([boardId, categoryId, listOrder(sort: Desc)])
  @@index([authorId])
  @@index([extraVars], type: Gin)
  @@map("documents")
}

// 댓글
model Comment {
  id             Int           @id @default(autoincrement())
  commentSrl     BigInt?       @unique
  documentId     Int
  parentId       Int?
  boardId        Int
  content        String
  isSecret       Boolean       @default(false)
  password       String?
  votedCount     Int           @default(0)
  blamedCount    Int           @default(0)
  authorId       Int?
  userIdSnapshot String?       @db.Citext
  nickName       String?
  memberId       String?
  email          String?       @db.Citext
  ipAddress      String?
  status         Int           @default(1)
  listOrder      BigInt        @default(0)
  regdate        DateTime      @default(now()) @db.Timestamptz
  lastUpdate     DateTime      @updatedAt @db.Timestamptz
  deletedAt      DateTime?     @db.Timestamptz

  document Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parent   Comment?        @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies  Comment[]       @relation("CommentReplies")
  author   User?           @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  files    FileAttachment[] @relation("CommentFiles")
  voteLogs CommentVoteLog[] @relation("CommentVoteLogs")
  reports  CommentReport[]  @relation("CommentReports")

  @@index([documentId, listOrder])
  @@index([parentId])
  @@index([authorId])
  @@map("comments")
}

// 카테고리 (계층 구조 허용)
model DocumentCategory {
  id            Int      @id @default(autoincrement())
  categorySrl   BigInt?  @unique
  boardId       Int
  parentId      Int?
  title         String
  description   String?
  color         String?
  expand        Boolean  @default(true)
  isDefault     Boolean  @default(false)
  groupIds      Int[]    @default([])
  documentCount Int      @default(0)
  listOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  board     Board             @relation(fields: [boardId], references: [id], onDelete: Cascade)
  parent    DocumentCategory? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  DocumentCategory[] @relation("CategoryTree")
  documents Document[]

  @@index([boardId, parentId, listOrder])
  @@map("document_categories")
}

// 게시판 부가 키 정의
model DocumentExtraKey {
  id            Int     @id @default(autoincrement())
  boardId       Int
  varIdx        Int
  varName       String
  varType       String  @default("text")
  varIsRequired Boolean @default(false)
  varSearch     Boolean @default(false)
  varSort       Boolean @default(false)
  varOptions    Json?
  langCode      String  @default("ko")

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([boardId, varIdx, langCode])
  @@index([boardId])
  @@map("document_extra_keys")
}

// 파일 첨부
model FileAttachment {
  id               Int              @id @default(autoincrement())
  fileSrl          BigInt?          @unique
  uploadTargetType UploadTargetType
  documentId       Int?
  commentId        Int?
  sourceFilename   String
  uploadedFilename String
  fileSize         BigInt
  mimeType         String
  width            Int?
  height           Int?
  duration         Int?
  directDownload   Boolean          @default(false)
  downloadCount    Int              @default(0)
  coverImage       Boolean          @default(false)
  isvalid          Boolean          @default(true)
  memberId         String?
  storageKey       String
  regdate          DateTime         @default(now()) @db.Timestamptz

  document Document? @relation("DocumentFiles", fields: [documentId], references: [id], onDelete: SetNull)
  comment  Comment?  @relation("CommentFiles", fields: [commentId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@index([commentId])
  @@map("file_attachments")
}

// 게시물 수정 로그
model DocumentUpdateLog {
  id           Int      @id @default(autoincrement())
  documentId   Int
  prevTitle    String
  prevContent  String
  prevExtraVars Json?
  editorId     Int?
  editorIp     String?
  regdate      DateTime @default(now()) @db.Timestamptz

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  editor   User?    @relation(fields: [editorId], references: [id], onDelete: SetNull)

  @@index([documentId, regdate(sort: Desc)])
  @@map("document_update_logs")
}

// 게시물/댓글 투표
model DocumentVote {
  id         Int      @id @default(autoincrement())
  documentId Int
  commentId  Int?
  voterId    String
  voteType   VoteType
  point      Int      @default(1)
  regdate    DateTime @default(now()) @db.Timestamptz

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, voterId, voteType])
  @@index([documentId])
  @@index([commentId])
  @@map("document_votes")
}

// 게시물/댓글 신고
model DocumentReport {
  id         Int      @id @default(autoincrement())
  documentId Int?
  commentId  Int?
  reporterId String
  reporterIp String?
  reason     String
  resolved   Boolean  @default(false)
  regdate    DateTime @default(now()) @db.Timestamptz

  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@index([commentId])
  @@index([resolved])
  @@map("document_reports")
}

// 휴지통 (소프트 삭제 게시물 임시 보관)
model Trash {
  id          Int      @id @default(autoincrement())
  documentId  Int      @unique
  deletedById Int?
  deletedAt   DateTime @default(now()) @db.Timestamptz
  expiresAt   DateTime @db.Timestamptz

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  deletedBy User?    @relation(fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@map("document_trash")
}

// =====================================================================
// SPEC-TAG-001: 태그 시스템 — Tag + DocumentTag 모델
// =====================================================================

model Tag {
  id        Int              @id @default(autoincrement())
  name      String           @unique
  count     Int              @default(0)
  createdAt DateTime         @default(now()) @db.Timestamptz
  documents DocumentTag[]

  @@index([count(sort: Desc)])
  @@map("tags")
}

model DocumentTag {
  documentId Int
  tagId      Int
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
  @@index([tagId])
  @@map("document_tags")
}

// =====================================================================
// SPEC-THEME-001: Theme / Layout / Skin / Assignment system
// =====================================================================

enum ThemeStatus {
  INSTALLED
  ACTIVE
  DISABLED
}

enum LayoutType {
  DESKTOP
  MOBILE
}

enum AssignmentScope {
  SITE
  DOMAIN
  MODULE_INSTANCE
}

enum MobileLayoutMode {
  USE_DEFAULT   // mlayout_srl = -1
  RESPONSIVE    // mlayout_srl = -2 (recommended default)
  SPECIFIC      // explicit mobile layout
}

model Theme {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  version     String
  author      String?
  parent      String?
  manifest    Json
  tokensSchema Json
  status      ThemeStatus @default(INSTALLED)
  installedAt DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt

  layouts     Layout[]
  skins       Skin[]
  widgetStyles WidgetStyle[]
  assignments ThemeAssignment[]

  @@index([status])
  @@map("themes")
}

model Layout {
  id         String     @id @default(cuid())
  legacySrl  Int?       @unique
  themeId    String
  name       String
  title      String
  layoutPath String
  layoutType LayoutType @default(DESKTOP)
  siteSrl    Int?
  extraVars  Json?

  theme      Theme      @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([themeId, name, layoutType])
  @@index([siteSrl])
  @@map("layouts")
}

model Skin {
  id            String   @id @default(cuid())
  themeId       String
  moduleType    String
  name          String
  title         String
  componentPath String

  theme         Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)
  colorSets     ColorSet[]

  @@unique([themeId, moduleType, name])
  @@index([moduleType])
  @@map("skins")
}

model ColorSet {
  id     String @id @default(cuid())
  skinId String
  name   String
  tokens Json

  skin   Skin   @relation(fields: [skinId], references: [id], onDelete: Cascade)

  @@unique([skinId, name])
  @@map("color_sets")
}

model WidgetStyle {
  id            String @id @default(cuid())
  themeId       String
  name          String
  componentPath String

  theme         Theme  @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([themeId, name])
  @@map("widget_styles")
}

model ThemeAssignment {
  id               String          @id @default(cuid())
  themeId          String
  scope            AssignmentScope
  refType          String
  refId            String
  layoutName       String?
  mobileLayoutName String?
  mlayoutMode      MobileLayoutMode @default(RESPONSIVE)
  skinName         String?
  tokensOverride   Json?
  createdAt        DateTime        @default(now()) @db.Timestamptz
  updatedAt        DateTime        @updatedAt

  theme            Theme           @relation(fields: [themeId], references: [id])

  @@unique([scope, refType, refId])
  @@index([refId])
  @@map("theme_assignments")
}

// =====================================================================
// SPEC-ADDON-001: 애드온 시스템 (Slice A — Foundation)
// =====================================================================

// REQ-ADDON-020: 애드온 설정 테이블 (전역 단일 행)
model AddonConfig {
  name               String    @id
  enabled            Boolean   @default(true)
  priority           Int       @default(0)
  lastDisabledAt     DateTime?
  lastDisabledReason String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("addon_configs")
}

// 댓글 추천/비추천 로그 (REQ-COMMENT-004)
model CommentVoteLog {
  id        Int      @id @default(autoincrement())
  commentId Int
  memberId  Int
  voteType  Int      // 1=추천, -1=비추천
  regdate   DateTime @default(now()) @db.Timestamptz
  comment   Comment  @relation("CommentVoteLogs", fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, memberId])
  @@index([commentId])
  @@map("comment_vote_logs")
}

// 댓글 신고 로그 (REQ-COMMENT-005)
model CommentReport {
  id         Int      @id @default(autoincrement())
  commentId  Int
  reporterId Int
  reporterIp String?  @db.Citext
  reason     String?  @db.Text
  regdate    DateTime @default(now()) @db.Timestamptz
  comment    Comment  @relation("CommentReports", fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, reporterId])
  @@index([commentId])
  @@map("comment_reports")
}

// =====================================================================
// SPEC-ADMIN-002: 방문자 통계 (REQ-ADMIN2-001, REQ-ADMIN2-140)
// =====================================================================

// 일별 방문자 집계 테이블 — Phase 1에서는 최소 기능, Phase 2에서 확장
model DailyVisit {
  id             Int      @id @default(autoincrement())
  siteId         Int
  date           DateTime @db.Date
  uniqueVisitors Int      @default(0)
  pageViews      Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, date])
  @@index([date])
  @@map("daily_visits")
}

// =====================================================================
// SPEC-STATS-001: Page View Statistics (REQ-STATS-001, REQ-STATS-002)
// =====================================================================

/**
 * PageView — 개별 페이지 뷰 로그
 *
 * REQ-STATS-001: Next.js middleware에서 모든 페이지 요청을 인터셉트하여 저장
 * - 봇 User-Agent는 제외
 * - /api/*, /admin/* 경로는 제외
 * - visitorId는 세션 기반 해시 (UV 중복 제거용)
 */
model PageView {
  id        BigInt   @id @default(autoincrement())
  date      DateTime @db.Date
  hour      Int      // 0-23
  path      String   @db.VarChar(500)
  visitorId String   @db.VarChar(64) // 세션 기반 해시
  isMobile  Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([date, path])
  @@index([date, hour])
  @@index([visitorId])
  @@map("page_views")
}

/**
 * DailyStat — 일별 통계 집계
 *
 * REQ-STATS-002: 매일 00:05 UTC에 전일 통계 집계 (cron job)
 * - uv: 일별 순방문자 수
 * - pv: 일별 페이지뷰
 * - newMembers: 신규 가입자 수
 * - newDocuments: 게시물 작성 수
 * - newComments: 댓글 작성 수
 */
model DailyStat {
  date         DateTime @id @db.Date
  uv           Int      @default(0)
  pv           Int      @default(0)
  newMembers   Int      @default(0)
  newDocuments Int      @default(0)
  newComments  Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  @@map("daily_stats")
}

// =====================================================================
// SPEC-ADMIN-002 Slice 2E: 스팸 필터 시스템
// =====================================================================

/**
 * SpamDeniedWord — 금지어 목록
 *
 * REQ-ADMIN2-121: 문서/댓글 제출 시 금지어 포함 여부 검사
 */
model SpamDeniedWord {
  id        Int      @id @default(autoincrement())
  siteId    Int
  word      String   @db.VarChar(200)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, word])
  @@index([siteId])
  @@map("spam_denied_words")
}

/**
 * SpamDeniedIp — 차단 IP 목록
 *
 * REQ-ADMIN2-120: 문서/댓글 제출 시 IP 차단 여부 검사
 */
model SpamDeniedIp {
  id        Int      @id @default(autoincrement())
  siteId    Int
  ipPattern String   @db.VarChar(100) // IPv4/IPv6 또는 CIDR 표기법
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, ipPattern])
  @@index([siteId])
  @@map("spam_denied_ips")
}

/**
 * SpamRule — 스팸 필터 규칙 (속도 제한 등)
 *
 * REQ-ADMIN2-123: 제출 속도 제한 설정 (도배 방지)
 */
model SpamRule {
  id              Int      @id @default(autoincrement())
  siteId          Int
  actionType      String   @db.VarChar(50) // 'document.create', 'comment.create', etc.
  maxSubmissions  Int      @default(5) // N초당 M회
  windowSeconds   Int      @default(60) // 윈도우 크기 (초)
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, actionType])
  @@index([siteId])
  @@map("spam_rules")
}

/**
 * SpamUrlBlacklist — URL 블랙리스트
 *
 * SPEC-SPAM-001 REQ-SPAM-002: 게시물/댓글 내 URL을 추출하여 차단 도메인 목록과 비교
 */
model SpamUrlBlacklist {
  id        Int      @id @default(autoincrement())
  siteId    Int
  domain    String   @db.VarChar(200) // 차단 도메인 (e.g., "spam.com", "*.spam.com")
  isRegex   Boolean  @default(false) // 정규식 지원 여부
  reason    String?  @db.Text // 차단 사유 (관리자 메모)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, domain])
  @@index([siteId])
  @@map("spam_url_blacklists")
}

/**
 * SpamReviewQueue — 스팸 의심 콘텐츠 검토 큐
 *
 * SPEC-SPAM-001 REQ-SPAM-005: 관리자 검토 큐 페이지 제공
 */
model SpamReviewQueue {
  id         Int      @id @default(autoincrement())
  siteId     Int
  type       String   @db.VarChar(20) // 'document' | 'comment'
  contentId  Int // Document.id 또는 Comment.id
  reason     String   @db.VarChar(100) // 'forbidden_word' | 'blacklist_url' | 'report_threshold' | 'akismet' | 'duplicate_content'
  status     String   @default("pending") @db.VarChar(20) // 'pending' | 'approved' | 'deleted' | 'banned'
  metadata   Json?    @default("{}") // 추가 정보 (matchedWord, matchedDomain, reporterCount 등)
  createdAt  DateTime @default(now()) @db.Timestamptz
  reviewedAt DateTime? @db.Timestamptz
  reviewerId Int?

  @@index([siteId, status])
  @@index([type, contentId])
  @@index([createdAt])
  @@map("spam_review_queues")
}

// =====================================================================
// SPEC-ADMIN-002 Slice 3A: 설문(Poll) 시스템
// =====================================================================

/**
 * Poll — 설문
 *
 * REQ-ADMIN2-083: 설문 목록 (제목/상태/투표수/기간)
 * REQ-ADMIN2-084: 설문 생성/수정 시 질문/옵션/복수선택여부/투표기간 영속화
 * REQ-ADMIN2-086: 비회원 투표 허용, 중복 투표 방지 방식
 */
model Poll {
  id                   Int      @id @default(autoincrement())
  siteId               Int
  title                String   @db.VarChar(200)
  description          String?  @db.Text
  allowGuestVote       Boolean  @default(false)
  allowMultipleChoice  Boolean  @default(false)
  // 중복 투표 방지 방식: 'by-member' | 'by-ip' | 'by-cookie'
  duplicateVotePolicy  String   @default("by-member") @db.VarChar(20)
  startAt              DateTime @db.Timestamptz
  endAt                DateTime @db.Timestamptz
  createdAt            DateTime @default(now()) @db.Timestamptz
  updatedAt            DateTime @updatedAt @db.Timestamptz

  site          Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  options       PollOption[]
  votes         PollVote[]
  documentPolls DocumentPoll[]

  @@index([siteId])
  @@map("polls")
}

/**
 * PollOption — 설문 선택 항목
 */
model PollOption {
  id        Int      @id @default(autoincrement())
  pollId    Int
  label     String   @db.VarChar(200)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
  @@map("poll_options")
}

/**
 * PollVote — 설문 투표 기록
 *
 * memberId 는 비회원 투표(REQ-ADMIN2-086) 를 위해 nullable.
 * duplicateVotePolicy='by-member' 인 경우 (pollId, memberId) 유니크 제약으로 중복을 막는다.
 * Postgres 의 유니크 제약은 NULL 값을 서로 다른 값으로 취급하므로, 비회원 투표(memberId=NULL)
 * 는 이 제약에 걸리지 않는다 — by-ip/by-cookie 정책의 중복 방지는 애플리케이션 레벨에서
 * voterIp/voterCookie 를 조회하여 처리한다 (DB partial unique index 미사용).
 */
model PollVote {
  id           Int      @id @default(autoincrement())
  pollId       Int
  pollOptionId Int
  memberId     Int?
  voterIp      String?  @db.VarChar(45)
  createdAt    DateTime @default(now()) @db.Timestamptz

  poll       Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollOption PollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)

  @@unique([pollId, memberId])
  @@index([pollId])
  @@index([pollOptionId])
  @@index([pollId, voterIp])
  @@map("poll_votes")
}

/**
 * DocumentPoll — 게시물-설문 연결 (SPEC-POLL-001)
 *
 * 하나의 게시물에 하나의 설문을 첨부할 수 있다.
 * REQ-POLL-001: 글쓰기 폼에서 설문 첨부 기능
 */
model DocumentPoll {
  documentId Int     @default(0)
  pollId     Int
  sortKey    Int     @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  poll     Poll      @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@id([documentId, pollId])
  @@index([pollId])
  @@map("document_polls")
}

/**
 * NicknameChangeLog — 닉네임 변경 이력 (SPEC-ADMIN-002 Slice 3B REQ-ADMIN2-056/057).
 *
 * changedByAdminId 가 null 이면 회원 자가 변경(미구현, 추후 확장 대비 nullable)을 의미하고,
 * 값이 있으면 관리자가 대신 변경했음을 의미한다.
 */
model NicknameChangeLog {
  id               Int      @id @default(autoincrement())
  userId           Int
  oldNickName      String   @db.VarChar(40)
  newNickName      String   @db.VarChar(40)
  changedByAdminId Int?
  changedAt        DateTime @default(now()) @db.Timestamptz

  user User @relation("NicknameChangeLogUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([changedAt])
  @@map("nickname_change_logs")
}

// =====================================================================
// SPEC-NOTIFICATION-001: Notification Center (Slice A — Foundation)
// =====================================================================

/**
 * NotificationCategory — 알림 카테고리 enum
 *
 * SPEC-NOTIFICATION-001 REQ-NOTIF-006/031: MENTION/MESSAGE는 Slice B(Slice A는 enum만 선반영)
 */
enum NotificationCategory {
  COMMENT         // 댓글 작성 알림 (문서 작성자에게)
  COMMENT_REPLY   // 대댓글 작성 알림 (부모 댓글 작성자에게)
  MENTION         // 멘션 알림 (Slice B)
  MESSAGE         // 쪽지 도착 알림 (future-hook)
}

/**
 * NotificationSourceType — 알림 소스 타입 enum
 *
 * SPEC-NOTIFICATION-001 REQ-NOTIF-006: MENTION 값을 미리 확보해 Slice B 마이그레이션 없이 기능 추가
 */
enum NotificationSourceType {
  COMMENT  // 댓글/대댓글
  MENTION  // 멘션 (Slice B)
  MESSAGE  // 쪽지 (future-hook)
}

/**
 * Notification — 알림 내역
 *
 * SPEC-NOTIFICATION-001 REQ-NOTIF-001/010: Point 모델 구조 참조 (packages/point/src/service.ts)
 * - actorId/actorNickname은 denormalized snapshot으로, 회원 삭제 후에도 목록 렌더링 가능
 * - recipientId 인덱스는 최신순 목록 조회 최적화를 위해 createdAt Desc 정렬 포함
 * - sourceType/sourceId는 중복 알림 방지(idempotency)를 위한 유니크 제약 조합
 */
model Notification {
  id             Int                    @id @default(autoincrement())
  recipientId    Int
  category       NotificationCategory
  sourceType     NotificationSourceType
  sourceId       Int
  actorId        Int?                   // nullable: 탈퇴 회원의 알림 보존
  actorNickname  String                 // snapshot: 회원 삭제 후에도 표시 가능
  read           Boolean               @default(false)
  readAt         DateTime?             @db.Timestamptz
  createdAt      DateTime              @default(now()) @db.Timestamptz

  recipient User @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId, recipientId])
  @@index([recipientId, createdAt(sort: Desc)])
  @@index([recipientId])
  @@index([sourceType, sourceId])
  @@index([createdAt])
  @@map("notifications")
}

/**
 * NotificationPreference — 회원별 알림 수신 설정
 *
 * SPEC-NOTIFICATION-001 REQ-NOTIF-030/032:
 * - 정규화 테이블 (@@unique([memberId, category]) — 레거시 와이드 컬럼 방식 미사용)
 * - 행 부재 = enabled=true (opt-out 모델, 기본값 활성)
 */
model NotificationPreference {
  id        Int                    @id @default(autoincrement())
  memberId  Int
  category  NotificationCategory
  enabled   Boolean               @default(true)
  createdAt DateTime              @default(now()) @db.Timestamptz
  updatedAt DateTime              @updatedAt @db.Timestamptz

  member User @relation("UserNotificationPreferences", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, category])
  @@index([memberId])
  @@map("notification_preferences")
}

// =====================================================================
// SPEC-MESSAGE-001: 1:1 개인 메시지 (쪽지) 시스템
// =====================================================================

/**
 * Message — 개인 쪽지
 *
 * SPEC-MESSAGE-001 REQ-MSG-001: 1:1 쪽지 발송 및 수신
 * - senderId/receiverId: 발신자/수신자 ID
 * - senderDel/receiverDel: 양측 독립 삭제 (REQ-MSG-004)
 * - readAt: 읽음 상태 (REQ-MSG-003)
 */
model Message {
  id           Int      @id @default(autoincrement())
  senderId     Int
  receiverId   Int
  subject      String   @db.VarChar(200)
  content      String   @db.Text
  readAt       DateTime? @db.Timestamptz
  senderDel    Boolean  @default(false)
  receiverDel  Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz

  sender   User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId, readAt])
  @@index([senderId])
  @@index([createdAt(sort: Desc)])
  @@map("messages")
}
