# Auto-detect text files and normalize to LF
* text=auto eol=lf

# TypeScript / JavaScript
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf

# Web
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf

# Config
*.sh text eol=lf
*.py text eol=lf
*.env text eol=lf
.env* text eol=lf
Dockerfile text eol=lf

# Prisma
*.prisma text eol=lf
*.sql text eol=lf

# Binary — no conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
