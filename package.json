{
  "name": "rhymix-ts",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript + Next.js 16 redesign of Rhymix CMS",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @rhymix-ts/web test:e2e",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "db:generate": "pnpm --filter @rhymix-ts/db prisma:generate",
    "db:push": "pnpm --filter @rhymix-ts/db prisma:push",
    "db:migrate": "pnpm --filter @rhymix-ts/db prisma:migrate",
    "db:studio": "pnpm --filter @rhymix-ts/db prisma:studio"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.0",
    "prettier": "^3.4.0",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.0",
    "typescript": "^5.9.0",
    "vitest": "^2.1.0"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false
  }
}
