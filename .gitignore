# ============================================
# MoAI-ADK Package Distribution .gitignore
# ============================================
# Version: 0.33.0
# Updated: 2026-01-10
# Purpose: Essential patterns for user projects
# ============================================

# ===========================================
# Go Build Artifacts
# ===========================================
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
cover.out
cover.html
cpu.prof
mem.prof

# ===========================================
# Build Artifacts & Distribution
# ===========================================
build/
dist/
*.egg-info/
*.egg

# ===========================================
# Python Cache & Bytecode
# ===========================================
__pycache__/
.pytest_cache/
*.pyc
*.pyo
*.pyd
.mypy_cache/
.ruff_cache/
*.db
*.sqlite
*.sqlite3
*.rdb
*.dbm

# ===========================================
# Virtual Environments
# ===========================================
venv/
.venv/
env/
.env/
.uv_cache/
.uv-cache/

# ===========================================
# Test Coverage
# ===========================================
.coverage
coverage.json
htmlcov/

# ===========================================
# IDE & Editors
# ===========================================
.vscode/
.idea/
*.swp
*.swo
*.sw?
*~
.cursor/
*.sublime-project
*.sublime-workspace
*.njsproj
*.sln
*.suo
.#*

# ===========================================
# OS Files
# ===========================================
# Mac
.DS_Store
.AppleDouble
.LSOverride
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns

# Windows
[Dd]esktop.ini
Thumbs.db
ehthumbs.db

# Linux
.directory

# ===========================================
# Logs & Temporary Files
# ===========================================
*.log
logs/*
!logs/.gitkeep
*.tmp
*.temp
*.bak
*.backup

# ===========================================
# Backups
# ===========================================
.moai-backups/
.moai/backups/
*.backup/
*-backup/
*_backup_*/

# ===========================================
# Secrets and Credentials (CRITICAL)
# ===========================================
# Environment files
.env
.env.*
!.env.example

# Certificate files
*.pem
*.p12
*.pfx
*.jks

# Private keys (specific patterns to avoid false positives)
# FIXED: Issue #237 - Replaced overly broad *key* and *secret* patterns
*-key.*
*_key.*
*.key.*
*-secret-key.*
*-api-key.*
api-key-*
secret-key-*
# 위 키 패턴들이 정상 소스까지 삼키는 것을 막는다.
# 실제 사례: apps/web/server/api/routers/admin/content-extra-key.ts 와 그 테스트가
# *-key.* 에 걸려 한 번도 커밋되지 못했다(다른 PC 에서 체크아웃하면 빌드가 깨진다).
# 자격증명은 .pem/.p12/.pfx/.jks 확장자로 관리하므로 소스 확장자만 되살린다.
!*-key.ts
!*-key.tsx
!*_key.ts
!*_key.tsx
# .test.ts / .spec.ts 처럼 중간 확장자가 붙는 형태도 되살린다
!*-key.*.ts
!*-key.*.tsx
!*_key.*.ts
!*_key.*.tsx
private-key*
*-secret.*
*_secret.*
*.secret.*
secret-*.*

# Credential patterns in environment files
*_secret=*
*_token=*

# Cloud provider credentials
.aws/config
.aws/credentials

# MoAI git-credential runtime files (defense-in-depth). The reconfigure wizard
# delegates git provider credentials to the gh/glab CLI and never writes an
# access token to a tracked config; these patterns ensure that if a
# credential-bearing runtime file is ever introduced under .moai/, it is not
# committed.
.moai/**/credentials.yaml
.moai/**/*.credentials

# MINK agent credentials (plaintext API keys, per AC-CR-026).
# Ignored anywhere in the tree so per-project auth dirs are never committed.
**/.mink/auth/

# ===========================================
# Claude Code Configuration
# ===========================================
.claude/settings.local.json
.claude/settings.local.*.json
.claude/.env.local*
.claude/local/
.claude/plans/
.claude/agent-memory/
.claude/worktrees/

# Skill-specific credentials
.claude/skills/*/.env*
.claude/skills/*/secrets/
.claude/skills/*/*/*secret*
.claude/skills/*/*/*key*
.claude/skills/*/*/*token*
# Re-include legitimate skill module files containing "token" in their name
!.claude/skills/*/modules/*token*.md

# ===========================================
# Local-Only Files (never sync via git pull)
# ===========================================
.moai/status_line.sh
.moai/memory/
.moai/worktrees/
.moai/branches/
# 로컬 파일 저장소 — M3 버튼 이미지 업로드가 처음 쓰기 시작한 런타임 디렉터리다.
# 추적 대상 소스가 하나도 없는데 무시 목록에 없어서, 넓은 `git add` 가 업로드 파일과
# e2e 잔여 PNG 를 삼킬 수 있었다 (실측: 1x1 테스트 PNG 21개 방치).
apps/web/uploads/

# ===========================================
# Update Noise-Suppression Ledgers (per-machine, never tracked)
# Per-machine state + cache ledgers used to suppress redundant update noise.
# ===========================================
.moai/state/
.moai/cache/

# ===========================================
# Plan Audit Reports (local artifacts)
# Plan-audit verdict reports are local artifacts; only .gitkeep is tracked.
# ===========================================
.moai/reports/plan-audit/*.md
!.moai/reports/plan-audit/.gitkeep

# ===========================================
# Evolution Telemetry (local-only usage data)
# Learnings and new-skills are git-tracked for team sharing.
# ===========================================
.moai/evolution/telemetry/*.jsonl
!.moai/evolution/telemetry/.gitkeep

# ===========================================
# Node.js (for docs/Nextra)
# ===========================================
node_modules/
*.tsbuildinfo
.tscache/
.next/
out/

# ===========================================
# Build Tools & Frameworks
# ===========================================
.turbo/
.nuxt/
dist-ssr/

# ===========================================
# Deployment & CI/CD
# ===========================================
.vercel/
.netlify/
.firebase/

# ===========================================
# MoAI Runtime Reports / Logs / Per-package State
# Auto-generated per-session/per-run artifacts; not meant for git tracking.
# ===========================================
.claude/*.lock
.moai/reports/session-*.md
.moai/reports/sync-report-*.md
.moai/logs/*
!.moai/logs/.gitkeep
.moai/harness/
.moai/lessons-inbox.jsonl
**/.moai/plans/
**/.moai/state/
# pnpm 워크스페이스 패키지(apps/*, packages/*, themes/*) 안에 생기는 .moai/ 폴더는
# 전부 MoAI 툴링이 만드는 세션 스크래치(state/context-usage.json, state/session-memo.md 등)
# — 루트 .moai/(SPEC, 설정)는 이 패턴에 걸리지 않는다.
apps/*/.moai/
packages/*/.moai/
themes/*/.moai/

# ===========================================
# Test / E2E Generated Artifacts
# ===========================================
coverage/
screenshots/
.playwright-mcp/
.tmp-report/
test-results/
graphify-out/
**/graphify-out/